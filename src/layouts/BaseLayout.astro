---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import { siteName, siteTagline } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title, description = siteTagline, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${siteTagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const isHome = path === withBase('') || path === import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,560&family=Source+Sans+3:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="brand" href={withBase('')}>
				<span class="brand-mark">{siteName}</span>
				<span class="brand-tag">{siteTagline}</span>
			</a>
			<nav class="nav" aria-label="Primary">
				<a href={withBase('')} aria-current={isHome ? 'page' : undefined}>Home</a>
				<a
					href={withBase('archive/')}
					aria-current={path.includes('/archive') ? 'page' : undefined}>Archive</a
				>
				<a href={withBase('about/')} aria-current={path.includes('/about') ? 'page' : undefined}
					>About</a
				>
			</nav>
		</header>
		<main id="main" class="wrap">
			<slot />
		</main>
		<footer class="site-footer">
			<p><a href={withBase('admin/')}>Write an entry</a></p>
			<p>
				{siteName} is a personal journal. It is not therapy, diagnosis, or a crisis service.
			</p>
			<p>
				If you are in immediate danger, contact local emergency services. In the US, call or text
				{' '}
				<a href="tel:988">988</a>. International resources:{' '}
				<a href="https://www.iasp.info/suicidalthoughts/">IASP</a>.
			</p>
		</footer>
	</body>
</html>
