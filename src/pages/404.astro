---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Page not found" noindex>
 <section class="hero">
  <p class="entry-meta">404</p>
  <h1>This page has drifted away.</h1>
  <p class="lede">The link may have changed, or this entry is no longer available.</p>
  <p><a href={withBase('')}>Return home</a> · <a href={withBase('archive/')}>Browse the archive</a></p>
 </section>
</BaseLayout>
